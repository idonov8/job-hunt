# Neon pooled connection string (Neon console -> Connect -> Pooled connection)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Bearer token agents send as `Authorization: Bearer $AGENT_TOKEN`
AGENT_TOKEN="jhq_generate_a_long_random_string"

# Signs the browser session cookie. Any long random string.
SESSION_SECRET="generate_a_long_random_string"

# Password typed once at /login to unlock the web UI
APP_PASSWORD="choose_a_password"

# Local-first setup: prefer `npm run setup` to generate private credentials.
# DATABASE_DRIVER=pg uses normal Postgres; omit it to keep Neon HTTP transport.
# DATABASE_DRIVER=pg
# LOCAL_DB_PASSWORD=generated_by_setup
# DATABASE_URL=postgresql://jobhunter:<LOCAL_DB_PASSWORD>@127.0.0.1:54329/jobhunter
