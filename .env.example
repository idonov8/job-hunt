# Neon pooled connection string (Neon console -> Connect -> Pooled connection)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Bearer token agents send as `Authorization: Bearer $AGENT_TOKEN`
AGENT_TOKEN="jhq_generate_a_long_random_string"

# Signs the browser session cookie. Any long random string.
SESSION_SECRET="generate_a_long_random_string"

# Password typed once at /login to unlock the web UI
APP_PASSWORD="choose_a_password"
