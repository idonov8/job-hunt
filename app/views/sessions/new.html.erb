<main class="login"><section class="login-card"><div class="brand-mark">JH</div><p class="eyebrow">Personal workspace</p><h1>Welcome back.</h1><p class="muted">Sign in to your private job-hunting board.</p><%= form_with url: login_path do |form| %><%= form.label :password %><%= form.password_field :password, autofocus: true, autocomplete: "current-password" %><% if flash[:alert] %><p class="error"><%= flash[:alert] %></p><% end %><%= form.submit "Open Job Hunter" %><% end %></section></main>
