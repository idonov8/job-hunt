<header class="topbar"><div><strong>Job Hunter</strong><span> / personal workspace</span></div><nav><a href="/scan">Set up scans</a><%= button_to "Sign out", logout_path, method: :delete %></nav></header>
<% if @hunter["session"] && !@hunter["session"]["ended"] && (current = Job.find_by(slug: @hunter["session"]["queue"].first)) %>
<section class="focus" data-slug="<%= current.slug %>"><div class="focus-bar"><div><p class="eyebrow">Focus session</p><h1><%= current.role %> · <%= current.company %></h1></div><button data-hunter-action="end">End session</button></div><div class="focus-grid"><aside><h2>Why this role</h2><p><%= current.fit_note %></p><h2>Company</h2><p><%= current.company_summary.presence || "No company summary yet." %></p><h2>Connection</h2><p><%= current.connection_note.presence || "No connection note yet." %></p></aside><div class="frame"><% if current.application_url || current.url %><iframe src="<%= current.application_url || current.url %>" title="Application for <%= current.role %>"></iframe><a href="<%= current.application_url || current.url %>" target="_blank" rel="noopener">Open application externally ↗</a><% else %><p>No application URL is saved for this role.</p><% end %></div></div><div class="focus-actions"><span><%= @hunter["session"]["skipped"].length %> of 2 skips used</span><button data-hunter-action="skip">Skip for now</button><button class="complete" data-hunter-action="complete">I submitted this application</button></div></section>
<% end %>
<main class="shell" data-controller="hunter">
  <section class="hero"><div><p class="eyebrow">Keep moving</p><h1>Your next good role<br>is already in here.</h1></div><div class="level"><strong><%= @hunter["completed"].length * 100 %> XP</strong><span>Level <%= @hunter["completed"].length / 5 + 1 %></span></div></section>
  <section class="stats"><article><b><%= @jobs.count %></b><span>Openings</span></article><article><b><%= @jobs.count(&:fresh?) %></b><span>New this week</span></article><article><b><%= @hunter["selected"].length %></b><span>In queue</span></article><article><b><%= @hunter["completed"].length %></b><span>Completed</span></article></section>
  <div class="toolbar"><div class="tabs"><button class="active" data-tab="openings">Openings</button><button data-tab="queue">Application Queue</button><button data-tab="history">History</button><button data-tab="answers">Answers</button></div><input id="search" type="search" placeholder="Search roles, companies, tags…"></div>
  <section id="openings" class="panel"><div class="filters"><button data-filter="all" class="active">All</button><button data-filter="fresh">New</button><button data-filter="top">Top fit</button><button data-filter="remote">Remote</button></div><div class="jobs">
  <% @jobs.each do |job| %><article class="job" data-search="<%= [job.company,job.role,job.tags.join(' '),job.city].join(' ').downcase %>" data-fresh="<%= job.fresh? %>" data-top="<%= job.top_fit? %>" data-remote="<%= job.remote? || job.city == 'Remote' %>"><div class="job-head"><div class="logo"><%= job.company.first(2).upcase %></div><div><h2><%= job.role %></h2><p><%= job.company %> · <%= job.city || "Location open" %> · <%= job.employment %></p></div><% if job.fresh? %><span class="badge green">New</span><% end %><% if job.top_fit? %><span class="badge">Top fit</span><% end %></div><p class="fit"><%= job.fit_note.presence || job.company_summary.presence || "Add context on why this role belongs in your search." %></p><div class="tags"><% job.tags.each do |tag| %><span><%= tag %></span><% end %></div><div class="actions"><a href="<%= job.application_url || job.url || '#' %>" target="_blank" rel="noopener">View role ↗</a><button class="queue-button <%= 'queued' if @hunter['selected'].include?(job.slug) %>" data-slug="<%= job.slug %>"><%= @hunter['selected'].include?(job.slug) ? 'Queued ✓' : 'Add to queue' %></button></div></article><% end %>
  </div></section>
  <section id="queue" class="panel hidden"><div class="empty"><h2>Application Queue</h2><p>Roles you choose from Openings stay here until you complete them.</p><button id="start-session">Start focus session</button></div></section>
  <section id="history" class="panel hidden"><div class="empty"><h2>Application history</h2><p><%= @hunter["completed"].empty? ? "Completed applications will appear here." : "#{@hunter['completed'].length} applications completed." %></p></div></section>
  <section id="answers" class="panel hidden"><div class="empty"><h2>Saved answers</h2><p><%= @hunter["answers"].empty? ? "Answers you record after applying are saved for reuse." : "#{@hunter['answers'].length} answers ready to reuse." %></p></div></section>
  <footer><%= @scan ? "Last scan #{@scan.scanned_on.strftime('%d %b %Y')} · #{@scan.sources}" : "No scans recorded yet" %></footer>
</main>
