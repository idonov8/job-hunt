<header class="topbar"><div><strong>Go Hunt</strong></div><nav><%= button_to "Sign out", logout_path, method: :delete %></nav></header>
<% if @hunter["session"] && !@hunter["session"]["ended"] && (current = Job.find_by(slug: @hunter["session"]["queue"].first)) %>
<section class="focus" data-slug="<%= current.slug %>"><div class="focus-bar"><div><p class="eyebrow">Focus session</p><h1><%= current.role %> · <%= current.company %></h1></div><button data-hunter-action="end">End session</button></div><div class="focus-grid"><aside><h2>Why this role</h2><p><%= current.fit_note %></p><h2>Company</h2><p><%= current.company_summary.presence || "No company summary yet." %></p><h2>Connection</h2><p><%= current.connection_note.presence || "No connection note yet." %></p></aside><div class="frame"><% if current.application_url || current.url %><iframe src="<%= current.application_url || current.url %>" title="Application for <%= current.role %>"></iframe><a href="<%= current.application_url || current.url %>" target="_blank" rel="noopener">Open application externally ↗</a><% else %><p>No application URL is saved for this role.</p><% end %></div></div><div class="focus-actions"><span><%= @hunter["session"]["skipped"].length %> of 2 skips used</span><button data-hunter-action="skip">Skip for now</button><button class="complete" data-hunter-action="complete">I submitted this application</button></div></section>
<% end %>
<% locations = @jobs.map(&:city).compact_blank.uniq.sort %>
<% queued_jobs = @jobs.select { |job| @hunter["selected"].include?(job.slug) } %>
<% history_jobs = @jobs.select { |job| job.status.present? } %>
<main class="shell" data-controller="hunter">
  <section class="hero"><div><h1>Go Hunt</h1><a class="scan-link" href="/scan">Set up automated job scan with your agent</a></div></section>
  <div class="dashboard-grid"><div class="dashboard-main">
    <section class="stats"><article><b><%= @jobs.count %></b><span>Openings</span></article><article><b><%= @jobs.count { |job| job.status == "applied" } %></b><span>Applied</span></article><article><b><%= @jobs.count { |job| job.status == "talking" } %></b><span>In conversation</span></article><article><b><%= @jobs.count { |job| job.status == "offer" } %></b><span>Offers</span></article><article><b><%= @jobs.count { |job| job.status == "pass" } %></b><span>Passed</span></article><article><b><%= @hunter["selected"].length %></b><span>In queue</span></article></section>
    <div class="toolbar"><div class="tabs"><button class="active" data-tab="openings">Openings</button><button data-tab="queue">Application Queue</button><button data-tab="history">Application History</button><button data-tab="answers">Answers</button></div><input id="search" type="search" placeholder="Search roles, companies, tags…"></div>
    <section id="openings" class="panel"><div class="filters"><button data-filter="all" class="active">All</button><button data-filter="fresh">New</button><button data-filter="top">Top fit</button><button data-filter="remote">Remote</button><% locations.each do |location| %><button data-location="<%= location %>"><%= location %></button><% end %></div><div class="jobs"><%= render partial: "job_card", collection: @jobs, as: :job, locals: { hunter: @hunter } %></div></section>
    <section id="queue" class="panel hidden"><% if queued_jobs.any? %><div class="jobs compact-jobs"><%= render partial: "job_card", collection: queued_jobs, as: :job, locals: { hunter: @hunter } %></div><% else %><div class="empty"><h2>Application Queue</h2><p>Choose roles in Openings to add them here.</p></div><% end %></section>
    <section id="history" class="panel hidden"><% if history_jobs.any? %><div class="jobs compact-jobs"><%= render partial: "job_card", collection: history_jobs, as: :job, locals: { hunter: @hunter } %></div><% else %><div class="empty"><h2>Application history</h2><p>Update a role's communication status to build your history.</p></div><% end %></section>
    <section id="answers" class="panel hidden"><div class="empty"><h2>Saved answers</h2><p><%= @hunter["answers"].empty? ? "Answers you record after applying are saved for reuse." : "#{@hunter['answers'].length} answers ready to reuse." %></p></div></section>
  </div><aside class="dashboard-rail"><button class="hunter-start" data-start-session>Start Job Hunt</button><section class="xp-card"><p class="eyebrow">Your progress</p><strong><%= @xp %> XP</strong><span>Level <%= @level %></span><div class="xp-meter" aria-label="<%= @xp %> XP"><i style="width:<%= @xp % 500 / 5 %>%"></i></div><small><%= 500 - (@xp % 500) %> XP to level <%= @level + 1 %></small></section></aside></div>
  <footer><%= @scan ? "Last scan #{@scan.scanned_on.strftime('%d %b %Y')} · #{@scan.sources}" : "No scans recorded yet" %></footer>
</main>
