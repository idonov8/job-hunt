<% description = job.fit_note.presence || job.company_summary.presence || "Add context on why this role belongs in your search." %>
<article class="job" data-search="<%= [job.company, job.role, job.tags.join(" "), job.city].join(" ").downcase %>" data-fresh="<%= job.fresh? %>" data-top="<%= job.top_fit? %>" data-remote="<%= job.remote? || job.city == "Remote" %>" data-city="<%= job.city %>">
  <div class="job-head"><div class="logo"><%= job.company.first(2).upcase %></div><div><h2><%= job.role %></h2><p><%= job.company %> · <%= job.city || "Location open" %> · <%= job.employment %></p></div><% if job.fresh? %><span class="badge green">New</span><% end %><% if job.top_fit? %><span class="badge">Top fit</span><% end %></div>
  <% if description.length > 140 %><details class="fit"><summary><span><%= description %></span></summary><p><%= description %></p></details><% else %><p class="fit"><%= description %></p><% end %>
  <div class="tags"><% if (minutes = job.form_index&.dig("minutes")) %><span class="forecast">Estimated <%= minutes %> min</span><% end %><% job.tags.each do |tag| %><span><%= tag %></span><% end %></div>
  <div class="actions"><a href="<%= job.application_url || job.url || "#" %>" target="_blank" rel="noopener">View role ↗</a><select class="status-control status-<%= job.status.presence || "new" %>" data-status-select data-slug="<%= job.slug %>" aria-label="Status for <%= job.company %>"><option value="" <%= "selected" if job.status.blank? %>>Not started</option><option value="applied" <%= "selected" if job.status == "applied" %>>Applied</option><option value="talking" <%= "selected" if job.status == "talking" %>>In conversation</option><option value="offer" <%= "selected" if job.status == "offer" %>>Offer</option><option value="pass" <%= "selected" if job.status == "pass" %>>Passed</option></select><% if job.status.blank? %><button class="queue-button <%= "queued" if hunter["selected"].include?(job.slug) %>" data-slug="<%= job.slug %>"><%= hunter["selected"].include?(job.slug) ? "Queued ✓" : "Add to queue" %></button><% end %></div>
</article>
